{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "~/*": ["./app/*"],
      "@/*": ["./*"],
      "@repo/shadcn/*": ["../../packages/shadcn/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
