{
  "name": "@repo/api",
  "type": "module",
  "scripts": {
    "dev": "rslib build --watch",
    "build": "rslib build",
    "start": "node ./dist/esm/index.js",
    "prisma:pull": "dotenv -e ../../.env.development -- prisma db pull",
    "prisma:push": "dotenv -e ../../.env.development -- prisma db push",
    "prisma:generate": "dotenv -e ../../.env.development -- prisma generate"
  },
  "dependencies": {
    "@effect/schema": "^0.75.5",
    "@hono/effect-validator": "^1.2.0",
    "@hono/node-server": "^1.19.6",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@scalar/hono-api-reference": "^0.9.34",
    "effect": "^3.19.14",
    "hono": "^4.11.3",
    "hono-openapi": "^1.1.2",
    "minio": "^8.0.6",
    "pg": "^8.17.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/rslib-config": "workspace:*",
    "@rslib/core": "^0.19.1",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^20.19.27",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.2.0",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/src/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./client": {
      "types": "./dist/esm/src/client.d.ts",
      "import": "./dist/esm/client.js"
    }
  }
}
