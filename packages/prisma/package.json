{
  "name": "@repo/prisma",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "check": "tsc --noEmit",
    "prisma:generate": "dotenv -e .env.dev -- prisma generate",
    "prisma:deploy": "dotenv -e .env.prod -- prisma migrate deploy",
    "prisma:dev": "dotenv -e ../../.env.dev -- prisma migrate dev",
    "prisma:push:dev": "dotenv -e ../../.env.dev -- prisma db push",
    "prisma:pull:dev": "dotenv -e .env.dev -- prisma db pull",
    "prisma:studio:dev": "dotenv -e .env.dev -- prisma studio",
    "prisma:reset:dev": "dotenv -e .env.dev -- prisma migrate reset"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/rslib-config": "workspace:*",
    "@rslib/core": "^0.19.1",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/client-runtime-utils": "^7.2.0",
    "prisma": "^7.2.0",
    "ws": "^8.19.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/src/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/src/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  }
}
